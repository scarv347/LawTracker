# LawTrack Ask-LawTrack AI — server-side environment (local only, never commit)
# Copy this file to server/.env and fill in your own values.

# ASU AIR (OpenAI-compatible) credentials — server-side only. NEVER put these in frontend code.
ASU_AIR_API_KEY=
ASU_AIR_MODEL=

# Optional — defaults to https://openai.rc.asu.edu/v1
# ASU_AIR_BASE_URL=https://openai.rc.asu.edu/v1